<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gauge Ashton Stricklin — Creative Director</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Barlow+Condensed:wght@200;300;400;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --black: #080808;
  --off-black: #0f0f0f;
  --dark: #161616;
  --mid: #2a2a2a;
  --accent: #c8a96e;
  --accent-dim: #9a7d4a;
  --white: #f0ece4;
  --grey: #888;
}

html { scroll-behavior: smooth; }

body {
  background: var(--black);
  color: var(--white);
  font-family: 'Barlow', sans-serif;
  font-weight: 300;
  cursor: none;
  overflow-x: hidden;
}

/* CURSOR */
.cursor {
  position: fixed;
  width: 10px; height: 10px;
  background: var(--accent);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: width 0.2s, height 0.2s;
  mix-blend-mode: difference;
}
.cursor-ring {
  position: fixed;
  width: 36px; height: 36px;
  border: 1px solid var(--accent);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s, opacity 0.3s;
  opacity: 0.5;
}

/* NAV */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 60px;
  transition: background 0.4s ease;
}
.nav-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 22px;
  letter-spacing: 4px;
  color: var(--white);
  text-decoration: none;
}
.nav-logo span { color: var(--accent); }
.nav-links {
  display: flex;
  gap: 48px;
  list-style: none;
}
.nav-links a {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--grey);
  text-decoration: none;
  transition: color 0.3s;
}
.nav-links a:hover { color: var(--accent); }
.nav-cta {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--black);
  background: var(--accent);
  padding: 10px 28px;
  text-decoration: none;
  transition: background 0.3s;
}
.nav-cta:hover { background: var(--white); }

/* HERO */
.hero {
  height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: end;
  padding: 0 60px 80px;
  position: relative;
  overflow: hidden;
}
.hero-noise {
  position: absolute;
  inset: 0;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 200px;
  pointer-events: none;
  z-index: 1;
}
.hero-grid-lines {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 0.035;
  background-image:
    linear-gradient(var(--accent) 1px, transparent 1px),
    linear-gradient(90deg, var(--accent) 1px, transparent 1px);
  background-size: 80px 80px;
  animation: gridDrift 24s linear infinite;
}
@keyframes gridDrift {
  0% { transform: translateY(0); }
  100% { transform: translateY(80px); }
}
.hero-glow {
  position: absolute;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(200,169,110,0.07) 0%, transparent 70%);
  top: 50%; left: 30%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 0;
  animation: breathe 6s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
  50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
}
.hero-left {
  position: relative;
  z-index: 2;
}
.hero-eyebrow {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 6px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.3s forwards;
}
.hero-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(70px, 9.5vw, 136px);
  line-height: 0.9;
  letter-spacing: 2px;
  margin-bottom: 36px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.5s forwards;
}
.hero-title .gold { color: var(--accent); }
.hero-title .italic {
  font-family: 'Barlow', sans-serif;
  font-style: italic;
  font-weight: 300;
  font-size: 0.45em;
  letter-spacing: 6px;
  text-transform: uppercase;
  display: block;
  color: rgba(240,236,228,0.4);
  margin-bottom: 8px;
}
.hero-sub {
  font-size: 15px;
  line-height: 1.8;
  color: rgba(240,236,228,0.55);
  max-width: 420px;
  margin-bottom: 48px;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.7s forwards;
}
.hero-actions {
  display: flex;
  gap: 28px;
  align-items: center;
  opacity: 0;
  animation: fadeUp 0.8s ease 0.9s forwards;
}
.btn-primary {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--black);
  background: var(--accent);
  padding: 16px 40px;
  text-decoration: none;
  display: inline-block;
  position: relative;
  overflow: hidden;
  transition: color 0.3s;
}
.btn-primary::after {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--white);
  transform: translateX(-101%);
  transition: transform 0.3s ease;
}
.btn-primary:hover::after { transform: translateX(0); }
.btn-primary span { position: relative; z-index: 1; }
.btn-ghost {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--grey);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: color 0.3s;
}
.btn-ghost::before {
  content: '';
  width: 40px; height: 1px;
  background: var(--grey);
  transition: width 0.3s, background 0.3s;
}
.btn-ghost:hover { color: var(--accent); }
.btn-ghost:hover::before { width: 60px; background: var(--accent); }

/* HERO RIGHT */
.hero-right {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  opacity: 0;
  animation: fadeUp 0.8s ease 1.1s forwards;
}
.social-proof-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 10px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--grey);
  margin-bottom: 24px;
}
.social-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  padding: 20px 0;
  border-bottom: 1px solid var(--mid);
  width: 100%;
  max-width: 360px;
  transition: border-color 0.3s;
}
.social-row:first-of-type { border-top: 1px solid var(--mid); }
.social-row:hover { border-color: var(--accent-dim); }
.social-platform {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--grey);
  flex: 1;
  text-align: right;
}
.social-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 36px;
  color: var(--white);
  line-height: 1;
  min-width: 120px;
  text-align: right;
  transition: color 0.3s;
}
.social-row:hover .social-num { color: var(--accent); }
.hero-total {
  margin-top: 28px;
  text-align: right;
  max-width: 360px;
  width: 100%;
  padding-top: 20px;
}
.hero-total-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  color: var(--accent);
  line-height: 1;
}
.hero-total-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 10px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--grey);
}
.scroll-line {
  position: absolute;
  bottom: 0; left: 60px;
  width: 1px; height: 80px;
  background: linear-gradient(to bottom, transparent, var(--accent));
  z-index: 2;
  animation: pulse 2s ease infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

/* MARQUEE */
.marquee-section {
  background: var(--accent);
  padding: 13px 0;
  overflow: hidden;
  white-space: nowrap;
}
.marquee-track {
  display: inline-block;
  animation: marquee 22s linear infinite;
}
.marquee-track span {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 14px;
  letter-spacing: 5px;
  color: var(--black);
  padding: 0 36px;
}
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* SECTION BASE */
.section-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 14px;
  display: block;
}
.section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(48px, 6vw, 88px);
  line-height: 0.92;
}

/* ABOUT */
.about-section {
  padding: 120px 60px;
  background: var(--off-black);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: center;
}
.about-img-wrap { position: relative; }
.about-img-frame {
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--dark);
  overflow: hidden;
  position: relative;
}
.about-img-frame img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: grayscale(15%);
  transition: transform 0.6s ease, filter 0.6s ease;
}
.about-img-frame:hover img { transform: scale(1.04); filter: grayscale(0%); }
.about-corner {
  position: absolute;
  bottom: -18px; right: -18px;
  width: 100px; height: 100px;
  border: 2px solid var(--accent);
  pointer-events: none;
}
.about-text .section-title { margin-bottom: 8px; }
.about-subtitle {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 14px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--accent-dim);
  margin-bottom: 36px;
}
.about-body {
  font-size: 15px;
  line-height: 1.85;
  color: rgba(240,236,228,0.6);
  margin-bottom: 20px;
}
.about-body strong { color: var(--white); font-weight: 400; }
.about-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 32px 0 48px;
}
.about-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent);
  border: 1px solid var(--accent-dim);
  padding: 6px 16px;
}
.about-stats {
  display: flex;
  gap: 48px;
  padding-top: 40px;
  border-top: 1px solid var(--mid);
}
.stat-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 40px;
  color: var(--accent);
  line-height: 1;
}
.stat-desc {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--grey);
  margin-top: 4px;
}

/* CREDIBILITY */
.cred-section {
  padding: 80px 60px;
  background: var(--black);
  border-top: 1px solid var(--mid);
  border-bottom: 1px solid var(--mid);
}
.cred-inner { display: flex; align-items: center; gap: 80px; }
.cred-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--grey);
  white-space: nowrap;
  flex-shrink: 0;
}
.cred-divider { width: 1px; height: 40px; background: var(--mid); flex-shrink: 0; }
.cred-list { display: flex; gap: 60px; flex-wrap: wrap; align-items: center; }
.cred-item {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px;
  letter-spacing: 3px;
  color: rgba(240,236,228,0.25);
  transition: color 0.3s;
  white-space: nowrap;
}
.cred-item:hover { color: var(--accent); }

/* WORK */
.work-section { padding: 120px 60px 60px; background: var(--black); }
.work-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 60px;
}
.work-header .section-title { margin-bottom: 0; }
.filter-tabs { display: flex; gap: 8px; }
.filter-tab {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 8px 18px;
  background: transparent;
  border: 1px solid var(--mid);
  color: var(--grey);
  cursor: none;
  transition: all 0.3s;
}
.filter-tab.active, .filter-tab:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--black);
}
.work-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 10px;
}

/* work-item is now an <a> tag — display:block keeps layout intact */
.work-item {
  position: relative;
  overflow: hidden;
  background: var(--dark);
  cursor: none;
  display: block;
  text-decoration: none;
  color: inherit;
}
.work-item:nth-child(1) { grid-column: span 7; min-height: 560px; }
.work-item:nth-child(2) { grid-column: span 5; aspect-ratio: 4/3; }
.work-item:nth-child(3) { grid-column: span 5; aspect-ratio: 4/3; }
.work-item:nth-child(4) { grid-column: span 4; aspect-ratio: 3/4; }
.work-item:nth-child(5) { grid-column: span 4; aspect-ratio: 3/4; }
.work-item:nth-child(6) { grid-column: span 4; aspect-ratio: 3/4; }
.work-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.work-item:hover img { transform: scale(1.06); }
.work-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(8,8,8,0.88) 0%, transparent 55%);
  opacity: 0;
  transition: opacity 0.4s;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px;
}
.work-item:hover .work-overlay { opacity: 1; }
.work-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 4px;
}
.work-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px;
  letter-spacing: 2px;
}

/* Swatches */
.sw1 { background: linear-gradient(135deg,#0d0d0d,#1a1208,#0d0900); }
.sw2 { background: linear-gradient(135deg,#0a0a10,#0d0d1a); }
.sw3 { background: linear-gradient(135deg,#100808,#1a0d0d); }
.sw4 { background: linear-gradient(135deg,#08080f,#10101a); }
.sw5 { background: linear-gradient(135deg,#0a0808,#1a1008); }
.sw6 { background: linear-gradient(135deg,#080810,#10101a); }

/* SERVICES */
.services-section { padding: 120px 60px; background: var(--off-black); }
.services-intro {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  margin-bottom: 80px;
  align-items: end;
}
.services-intro p {
  font-size: 15px;
  line-height: 1.8;
  color: rgba(240,236,228,0.55);
}
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}
/* Row 2: 2 cards centered in a 3-col grid */
.services-grid-row2 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  margin-top: 2px;
}
.services-grid-row2 .service-card:nth-child(1) { grid-column: 1; }
.services-grid-row2 .service-card:nth-child(2) { grid-column: 2; }

.service-card {
  background: var(--dark);
  padding: 48px 36px;
  position: relative;
  overflow: hidden;
  transition: background 0.4s;
}
.service-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0;
  width: 100%; height: 2px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s;
}
.service-card:hover { background: #1c1c1c; }
.service-card:hover::after { transform: scaleX(1); }
.service-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  color: var(--mid);
  line-height: 1;
  margin-bottom: 20px;
  transition: color 0.4s;
}
.service-card:hover .service-num { color: rgba(200,169,110,0.2); }
.service-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 30px;
  letter-spacing: 2px;
  margin-bottom: 14px;
}
.service-desc {
  font-size: 13px;
  line-height: 1.75;
  color: rgba(240,236,228,0.45);
  margin-bottom: 28px;
}
.service-price {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent);
}

/* PROCESS */
.process-section { padding: 120px 60px; background: var(--black); }
.process-list { margin-top: 60px; }
.process-item {
  display: grid;
  grid-template-columns: 72px 1fr 1fr;
  gap: 60px;
  align-items: center;
  padding: 44px 0;
  border-bottom: 1px solid var(--mid);
  transition: padding-left 0.35s ease;
}
.process-item:first-child { border-top: 1px solid var(--mid); }
.process-item:hover { padding-left: 20px; }
.process-step {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 52px;
  color: var(--mid);
  line-height: 1;
  transition: color 0.35s;
}
.process-item:hover .process-step { color: var(--accent); }
.process-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px;
  letter-spacing: 2px;
}
.process-desc {
  font-size: 13px;
  line-height: 1.75;
  color: rgba(240,236,228,0.45);
}

/* CONTACT */
.contact-section {
  padding: 160px 60px;
  background: var(--off-black);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.contact-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(200,169,110,0.06) 0%, transparent 65%);
  pointer-events: none;
}
.contact-section .section-title {
  font-size: clamp(56px, 8.5vw, 118px);
  margin-bottom: 20px;
}
.contact-section .section-title .gold { color: var(--accent); }
.contact-sub {
  font-size: 15px;
  color: rgba(240,236,228,0.5);
  max-width: 500px;
  margin: 0 auto 56px;
  line-height: 1.8;
}
.contact-social {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin-bottom: 56px;
  flex-wrap: wrap;
}
.contact-social-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  transition: opacity 0.3s;
}
.contact-social-link:hover { opacity: 0.7; }
.csn {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px;
  color: var(--white);
  letter-spacing: 2px;
}
.csp {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--grey);
}
.contact-divider {
  width: 1px; height: 60px;
  background: var(--mid);
  margin: 0 auto 56px;
}
.contact-email {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(22px, 3.5vw, 46px);
  color: var(--white);
  text-decoration: none;
  letter-spacing: 3px;
  border-bottom: 2px solid var(--accent);
  padding-bottom: 4px;
  transition: color 0.3s;
  display: inline-block;
  margin-bottom: 16px;
}
.contact-email:hover { color: var(--accent); }
.contact-phone {
  display: block;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 13px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--grey);
  text-decoration: none;
  margin-top: 16px;
  transition: color 0.3s;
}
.contact-phone:hover { color: var(--accent); }

/* FOOTER */
footer {
  background: var(--black);
  padding: 36px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--mid);
}
.footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 4px; }
